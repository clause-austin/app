# ---- Clause environment ----
# Everything is optional. Missing keys degrade to clearly-labelled fallbacks.

# Solana (devnet). RPC: a QuickNode devnet endpoint is ideal; public devnet works for demos.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Circle's official devnet USDC mint. Fund the treasury at https://faucet.circle.com (Solana Devnet).
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Keypairs live in ./.keys (generated by `npm run setup:solana`). Override paths if needed.
KEYS_DIR=./.keys

# Gemini Prediction Markets. Public market data needs no key.
# With a key+secret, hedges are placed as real orders; without, hedges are "paper" at live prices.
GEMINI_ENV=sandbox            # sandbox | production
GEMINI_API_KEY=
GEMINI_API_SECRET=

# ElevenLabs text-to-speech for settlement announcements (falls back to browser speech).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# QuickNode Streams webhook (Solana devnet stream filtered to the escrow wallet).
# Falls back to an in-process RPC poller when unset.
QUICKNODE_WEBHOOK_TOKEN=

# xAI Grok: one-line odds explainer at checkout (falls back to templated copy).
XAI_API_KEY=

# Merchant dashboard / demo controls
ADMIN_TOKEN=clause-demo
DATABASE_PATH=./data/clause.db
GEMINI_ACCOUNT=primary
